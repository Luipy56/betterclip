#!/usr/bin/env python3
"""Launcher for betterclip picker - can be invoked by Super+V shortcut."""

import sys
import os

# Ensure package is importable when run from bin/
script_dir = os.path.dirname(os.path.abspath(__file__))
root = os.path.dirname(script_dir)
if root not in sys.path:
    sys.path.insert(0, root)

from betterclip.picker import run_picker

if __name__ == "__main__":
    sys.exit(0 if run_picker() else 1)
